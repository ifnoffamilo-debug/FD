# Токен отдельного Telegram-бота от @BotFather
BOT_TOKEN=

# Telegram ID пользователей с доступом, через запятую
# Узнать ID можно командой /myid
ADMIN_IDS=123456789

# TokenRouter: вставьте ключ, созданный в разделе API Keys
# Полный ключ никому не отправляйте.
AI_API_KEY=
AI_BASE_URL=https://api.tokenrouter.com/v1
AI_MODEL=moonshotai/kimi-k3-free

# Настройки хранения
DATABASE_PATH=data/finance.db
TIMEZONE=Europe/Moscow
